# Canonical URL for metadata, sitemap, and RSS.
SITE_URL=https://blog-website-cstz.netlify.app

# Optional public reply address shown on articles.
PUBLIC_AUTHOR_EMAIL=

# Optional Plausible pageview counts. Match the canonical hostname exactly.
PUBLIC_PLAUSIBLE_DOMAIN=

# Owner dashboard password. Use at least 16 characters. Set separately in hosted runtime secrets.
SECOND_INK_ADMIN_PASSWORD=

# Optional guest draft review. Set the bridge secret on both hosts.
# The owner host uses REVIEW_ORIGIN. The guest host uses UPSTREAM and UPSTREAM_TOKEN.
SECOND_INK_REVIEW_ORIGIN=
SECOND_INK_REVIEW_BRIDGE_SECRET=
SECOND_INK_REVIEW_UPSTREAM=
SECOND_INK_REVIEW_UPSTREAM_TOKEN=

# Reader participation from the public edition. Set the public site's exact HTTPS origin
# and a distinct 32-byte hex secret on the owner and relay hosts. Public builds only need the relay's URL.
SECOND_INK_PUBLIC_READER_ORIGIN=
SECOND_INK_PUBLIC_READER_SECRET=
PUBLIC_READER_API_ORIGIN=

# Optional Invisible Turnstile. Configure both together as hosted runtime settings.
SECOND_INK_TURNSTILE_SITE_KEY=
SECOND_INK_TURNSTILE_SECRET_KEY=
