# Canonical URL for metadata, sitemap, and RSS.
SITE_URL=https://blog-website-cstz.netlify.app

# Optional public reply address shown on articles.
PUBLIC_AUTHOR_EMAIL=

# Optional Plausible pageview counts. Match the canonical hostname exactly.
PUBLIC_PLAUSIBLE_DOMAIN=

# Owner dashboard password. Use at least 16 characters. Set separately in hosted runtime secrets.
SECOND_INK_ADMIN_PASSWORD=

# Optional Invisible Turnstile. Configure both together as hosted runtime settings.
SECOND_INK_TURNSTILE_SITE_KEY=
SECOND_INK_TURNSTILE_SECRET_KEY=
