---
import '../styles/global.css';
import displayFont from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import readingFont from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';
import { site } from '../lib/site';
import TimeAwareTheme from '../components/TimeAwareTheme.astro';
import SiteAnalytics from '../components/SiteAnalytics.astro';
import { draftsEnabled } from '../lib/content';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'article' | 'website';
  wide?: boolean;
  noindex?: boolean;
  feed?: { href: string; title: string };
}

const { title, description = site.description, image = site.socialImage, imageAlt = site.socialImageAlt, type = 'website', wide = false, noindex = false, feed } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} — Notes from my reading desk`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const socialImage = new URL(image, Astro.site ?? Astro.url);
const path = Astro.url.pathname;
const preview = draftsEnabled();
const nav = [
  { href: '/start/', label: 'Start here' },
  { href: '/explore/', label: 'Explore' },
  { href: '/questions/', label: 'Questions' },
  { href: '/loose-threads/', label: 'Loose Threads' },
  { href: '/editions/', label: 'Editions' },
  preview ? { href: '/drafts/', label: 'Drafts' } : { href: '/saved/', label: 'Saved' },
];
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {(noindex || preview) && <meta name="robots" content={preview ? "noindex, nofollow" : "noindex"} />}
    <meta name="theme-color" content="#f6f0e4" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin="anonymous" />
    {type === 'article' && <link rel="preload" href={readingFont} as="font" type="font/woff2" crossorigin="anonymous" />}
    <link rel="icon" href="/favicon.png" type="image/png" />
    {!preview && <link rel="manifest" href="/manifest.webmanifest" />}
    {!preview && <link rel="apple-touch-icon" href="/offline-icon-192.png" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" href="/rss.xml" type="application/rss+xml" title={site.name} />
    {feed && <link rel="alternate" href={feed.href} type="application/rss+xml" title={feed.title} />}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <title>{pageTitle}</title>
    <TimeAwareTheme />
    {!preview && !noindex && !/^\/(saved|offline|desk|under-the-blotter)(\/|$)/.test(path) && <SiteAnalytics canonical={canonical} />}
  </head>
  <body data-documents-preview={preview || undefined}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header wrap">
      <a class="wordmark" href="/" aria-label="Second Ink home">
        <span class="registration" aria-hidden="true"></span><span>Second Ink</span>
      </a>
      <nav aria-label="Main navigation">
        {nav.map(({ href, label }) => <a href={href} aria-current={path === href ? 'page' : path.startsWith(href) ? 'location' : undefined}>{label}</a>)}
      </nav>
    </header>
    <main id="main-content" class:list={[wide && 'site-main-wide']} tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer wrap">
      <div><a href="/" class="footer-mark">Second Ink</a><p>{site.description}</p></div>
      <nav aria-label="Publication"><a href="/about/">About</a><a href="/newsletter/">Newsletter</a>{!preview && <a href="/offline/">Offline shelf</a>}<a href="/rss.xml">RSS</a></nav>
    </footer>
  </body>
</html>

<script>
  import { getOfflineWorker } from '../lib/offline-client';
  import '../scripts/prefetch-articles';
  if (!document.body.hasAttribute('data-documents-preview')) {
    if (document.readyState === 'complete') void getOfflineWorker();
    else window.addEventListener('load', () => void getOfflineWorker(), { once: true });
  }
</script>
