---
import { editionDate, editionPath, getEditions } from '../lib/editions';

const [edition] = await getEditions();
---

{edition && <section class="edition-teaser" aria-labelledby="home-edition-title">
  <div class="edition-teaser__meta">
    <p class="eyebrow">Latest reading edition</p>
    <time datetime={edition.data.publishedAt.toISOString()}>{editionDate.format(edition.data.publishedAt)}</time>
  </div>
  <div>
    <h2 id="home-edition-title"><a href={editionPath(edition)}>{edition.data.title}</a></h2>
    <p class="edition-teaser__description">{edition.data.description}</p>
    <a class="text-link" href="/editions/">Browse editions</a>
  </div>
</section>}

<style>
  .edition-teaser {
    display: grid;
    gap: .75rem 2rem;
    margin-block: 1.5rem clamp(2.5rem, 6vw, 4.5rem);
    padding: clamp(1rem, 3.5vw, 2rem);
    border-inline-start: 2px solid var(--blue);
    background: var(--wash);
  }

  .edition-teaser__meta p { margin: 0 0 .35rem; }
  .edition-teaser time { font-size: .875rem; color: var(--muted); }
  .edition-teaser h2 { font-size: clamp(2.15rem, 5vw, 3.4rem); text-wrap: balance; overflow-wrap: anywhere; }
  .edition-teaser h2 a { color: var(--ink); text-decoration-thickness: 1px; }
  .edition-teaser h2 a:hover, .edition-teaser h2 a:focus-visible { color: var(--blue); }
  .edition-teaser__description { max-inline-size: 48ch; margin: .65rem 0 .3rem; font: 400 1.1rem/1.5 var(--font-body); }

  @media (min-width: 48rem) {
    .edition-teaser { grid-template-columns: minmax(9rem, 1fr) minmax(0, 3fr); }
  }
</style>
