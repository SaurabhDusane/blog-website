---
interface Props {
  updates: Array<{ date: Date; note: string }>;
  revisions: Date[];
  thoughtsNow?: Array<{ date: Date; note: string; href?: string; linkLabel?: string }>;
}

const { updates, revisions, thoughtsNow = [] } = Astro.props;
const laterThoughts = [...thoughtsNow].sort((first, second) => second.date.getTime() - first.date.getTime());
const dates = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

{(updates.length || revisions.length || laterThoughts.length) > 0 && <div class="wrap reader-revisions">
  {laterThoughts.length > 0 && <section class="reader-revisions__thoughts" aria-labelledby="reader-thoughts-heading">
    <h2 id="reader-thoughts-heading">What I think now</h2>
    <ol role="list">
      {laterThoughts.map(({ date, note, href, linkLabel }) => (
        <li>
          <time datetime={date.toISOString().slice(0, 10)}>{dates.format(date)}</time>
          <p>{note}</p>
          {href && <a href={href}>{linkLabel ?? "Read what changed my view"}</a>}
        </li>
      ))}
    </ol>
  </section>}
  {updates.length > 0 && <section aria-label="Updates to this note">
    {updates.map(({ date, note }) => (
      <div class="reader-revisions__update">
        <h2>Update <time datetime={date.toISOString().slice(0, 10)}>{dates.format(date)}</time></h2>
        <p>{note}</p>
      </div>
    ))}
  </section>}
  {revisions.length > 0 && <details>
    <summary>Revision history</summary>
    <ol>
      {revisions.map((date) => <li><time datetime={date.toISOString().slice(0, 10)}>{dates.format(date)}</time></li>)}
    </ol>
  </details>}
</div>}

<style>
  .reader-revisions { margin-block-end: clamp(1.25rem, 3vw, 2.25rem); }
  .reader-revisions section { display: grid; gap: .7rem; }
  .reader-revisions__thoughts {
    max-inline-size: 44rem;
    margin-block-end: 1rem;
    padding: 1rem 1.2rem;
    border-inline-start: 2px solid var(--blue);
    background: var(--wash);
  }
  .reader-revisions__thoughts h2 { font-size: 1.65rem; }
  .reader-revisions__thoughts ol { list-style: none; margin: 0; padding: 0; }
  .reader-revisions__thoughts li + li { border-block-start: 1px solid var(--line); margin-block-start: .8rem; padding-block-start: .8rem; }
  .reader-revisions__thoughts time { color: var(--muted); font: 500 .88rem/1.4 var(--font-ui); }
  .reader-revisions__thoughts p { margin: .35rem 0; font: 400 1.04rem/1.5 var(--font-body); }
  .reader-revisions__thoughts a { font: 500 .9rem/1.4 var(--font-ui); }
  .reader-revisions__update { max-inline-size: 44rem; border-inline-start: 2px solid var(--red); padding: .75rem 1rem; }
  .reader-revisions__update h2 { font: 600 .94rem/1.3 var(--font-ui); }
  .reader-revisions__update time { color: var(--muted); margin-inline-start: .25rem; }
  .reader-revisions__update p { margin: .4rem 0 0; font: 400 1.04rem/1.5 var(--font-body); }
  .reader-revisions summary { cursor: pointer; width: fit-content; min-height: 2.75rem; padding-block: .65rem; color: var(--blue); }
  .reader-revisions ol { margin-block-start: .12rem; }
</style>
