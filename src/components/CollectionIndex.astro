---
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import EssayRow from './EssayRow.astro';
import { postPath } from '../lib/content';

interface Props {
  label: string;
  title: string;
  description: string;
  posts: CollectionEntry<'posts'>[];
  backHref: string;
  backLabel: string;
  ordered?: boolean;
  deskTopic?: boolean;
}

const { label, title, description, posts, backHref, backLabel, ordered = false, deskTopic = false } = Astro.props;
const List = ordered ? 'ol' : 'ul';
---

<Base title={title} description={description}>
  <section class="wrap interior collection-index">
    <a href={backHref} class="text-link collection-back"><span aria-hidden="true">←</span> {backLabel}</a>
    <p class="eyebrow">{label}</p>
    <h1>{title}</h1>
    <p class="lead">{description}</p>
    <slot />
    {(posts.length > 0 || deskTopic) && <List class="editorial-list" role="list">
      {deskTopic && <template id="desk-essay-row">
        <EssayRow href="/posts/DESK-ROW-SLUG/" title="DESK-ROW-TITLE" description="DESK-ROW-DESCRIPTION" minutes={0} mood="DESK-ROW-MOOD" />
      </template>}
      {posts.map((post) => <EssayRow href={postPath(post)} title={post.data.title} description={post.data.description} minutes={post.data.minutes} mood={post.data.mood} />)}
    </List>}
    {posts.length === 0 && <p data-desk-essay-empty={deskTopic || undefined}>The first essay for this page is still on the desk.</p>}
  </section>
</Base>

<style>
  .collection-index { max-width: 63rem; }
  .collection-back { margin-block-end: clamp(0.85rem, 2.65vw, 1.85rem); }
  .collection-index .eyebrow { margin-block-end: 0.65rem; }
</style>
