---
const { canonical } = Astro.props as { canonical: URL };
const domain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN?.trim();
---

{domain === canonical.hostname && canonical.protocol === 'https:' && (
  <script define:vars={{ origin: canonical.origin }}>
    const optedOut = navigator.globalPrivacyControl || navigator.doNotTrack === '1';
    if (origin === location.origin && navigator.onLine && !optedOut) {
      void fetch('https://plausible.io/api/event', {
        method: 'POST',
        body: JSON.stringify({ name: 'pageview', url: location.origin + location.pathname, domain: location.hostname }),
        headers: { 'Content-Type': 'text/plain' },
        mode: 'no-cors',
        keepalive: true,
        credentials: 'omit',
        referrerPolicy: 'no-referrer',
      }).catch(() => {});
    }
  </script>
)}
