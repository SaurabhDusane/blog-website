<div class="desk-operations" data-desk-operations>
  <details data-desk-readership>
    <summary>Readership this week</summary>
    <p role="status" data-operations-status></p>
    <div class="desk-operations__table" role="region" aria-label="Readership by essay" tabindex="0" data-readership-table hidden>
      <table>
        <caption class="sr-only">Reader actions by essay</caption>
        <thead><tr>
          <th scope="col">Essay</th><th scope="col">Finished</th><th scope="col">Saved</th>
          <th scope="col">Reactions</th><th scope="col">Replies</th>
        </tr></thead>
        <tbody data-readership-rows></tbody>
      </table>
    </div>
    <p class="desk-operations__hint">Finishes and saves count once per browser for each essay from the time this feature was added. Reactions and replies come from the response desk.</p>
  </details>
  <details data-desk-release>
    <summary>Last verified live release</summary>
    <p role="status" data-operations-status></p>
    <a class="text-link" data-release-link hidden>Open verification report</a>
  </details>
</div>

<style>
  .desk-operations { margin-block: .4rem 1.25rem; border-block-start: 1px solid var(--line); }
  .desk-operations details { border-block-end: 1px solid var(--line); }
  .desk-operations summary { min-block-size: 2.75rem; padding-block: .55rem; cursor: pointer; color: var(--blue); width: fit-content; }
  .desk-operations p { margin: .2rem 0 .55rem; }
  .desk-operations__hint { color: var(--muted); font-size: .875rem; max-inline-size: 57ch; }
  .desk-operations__table { overflow: auto; margin-block: .5rem; }
  table { border-collapse: collapse; min-inline-size: 27rem; inline-size: 100%; font-size: .9rem; }
  :is(th, td) { padding: .4rem .3rem; border-block-end: 1px solid var(--line); min-inline-size: 3.5rem; text-align: end; }
  th:first-child { text-align: start; overflow-wrap: anywhere; }
</style>
