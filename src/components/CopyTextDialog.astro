---
interface Props { id: string }
const { id } = Astro.props;
---

<dialog class="copy-dialog" aria-labelledby={`${id}-title`} data-copy-dialog>
  <form method="dialog">
    <h2 id={`${id}-title`}>Ready to copy</h2>
    <label for={`${id}-text`}>Select and copy this text.</label>
    <textarea id={`${id}-text`} rows="5" readonly></textarea>
    <button type="submit" class="button">Done</button>
  </form>
</dialog>

<style>
  .copy-dialog {
    width: min(34rem, calc(100% - 2rem));
    padding: 1.4rem;
    border: 1px solid var(--line);
    background: var(--paper);
    color: var(--ink);
  }

  .copy-dialog::backdrop {
    background: rgba(20, 23, 30, 0.5);
  }

  .copy-dialog h2 {
    margin-block: 0 0.7rem;
    font: 400 1.85rem/1 var(--font-display);
  }

  .copy-dialog label {
    display: block;
    margin-block-end: 0.3rem;
    color: var(--muted);
    font: 0.8rem/1.4 var(--font-ui);
  }

  .copy-dialog textarea {
    display: block;
    width: 100%;
    margin-block-end: 0.8rem;
    padding: 0.6rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: 0;
    background: var(--paper);
    color: var(--ink);
    font: 1rem/1.5 var(--font-body);
    resize: vertical;
  }
</style>
