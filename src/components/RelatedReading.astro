---
import type { CollectionEntry } from 'astro:content';
import { editionEntries, editionPath } from '../lib/editions';
import { questionEntries, questionPath } from '../lib/questions';

interface Props { posts: CollectionEntry<'posts'>[] }

const { posts } = Astro.props;
const [questions, editions] = await Promise.all([questionEntries(posts), editionEntries(posts)]);
const groups = [
  {
    title: 'Questions',
    description: 'Follow an idea I return to across several essays.',
    path: '/questions/',
    links: questions.filter(({ discoverable }) => discoverable).map(({ question }) => ({
      title: question.data.title,
      path: questionPath(question),
    })),
  },
  {
    title: 'Reading editions',
    description: 'Read a set of essays in the order I chose for them.',
    path: '/editions/',
    links: editions.filter(({ discoverable }) => discoverable).map(({ edition }) => ({
      title: edition.data.title,
      path: editionPath(edition),
    })),
  },
].filter(({ links }) => links.length > 0);

const previewLimit = 3;
---

{groups.length > 0 && (
  <details class="reading-collections">
    <summary>Read around an idea</summary>
    <div class="reading-collections__groups">
      {groups.map(({ title, description, path, links }) => (
        <div>
          <h2>{title}</h2>
          <p>{description}</p>
          <ul>
            {links.slice(0, previewLimit).map((entry) => <li><a href={entry.path}>{entry.title}</a></li>)}
          </ul>
          {links.length > previewLimit && <a class="text-link" href={path}>All {title.toLowerCase()}</a>}
        </div>
      ))}
    </div>
  </details>
)}

<style>
  .reading-collections { border-block-start: 1px solid var(--line); margin-block-start: 2.5rem; }
  summary { cursor: pointer; min-block-size: 2.75rem; padding-block: .6rem; font-weight: 650; }
  summary:hover { color: var(--blue); }
  .reading-collections__groups { display: grid; gap: 1.35rem; padding: .3rem 0 1rem; }
  h2 { font-size: clamp(1.6rem, 3vw, 2.1rem); }
  p { margin: .4rem 0 .6rem; color: var(--muted); }
  ul { margin: 0; padding-inline-start: 1.1rem; }
  li + li { margin-block-start: .25rem; }
  a { overflow-wrap: anywhere; }
  @media (min-width: 43rem) {
    .reading-collections__groups { grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr)); }
  }
</style>
