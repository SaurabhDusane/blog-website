---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import FollowQuestion from '../../../components/FollowQuestion.astro';
import { postPath } from '../../../lib/content';
import { questionEntries } from '../../../lib/questions';
import '../../../styles/discovery.css';
export async function getStaticPaths() {
  return (await questionEntries()).map((props) => ({ params: { slug: props.question.id }, props }));
}
const { question, entries } = Astro.props;
const { Content } = await render(question);
const feed = { href: `/questions/${question.id}/rss.xml`, title: question.data.title };
---

<Base title={question.data.title} description={question.data.description} feed={feed}>
  <div class="wrap discovery question-detail" data-question-entry>
    <a class="text-link" href="/questions/">All questions</a>
    <header class="discovery__header"><h1>{question.data.title}</h1><p>{question.data.description}</p></header>
    <div class="question-detail__intro"><Content /></div>
    <FollowQuestion id={question.id} essays={entries.map(({ post }) => post.id)} />
    <ol class="question-detail__essays" role="list">
      {entries.map(({ post, note }) => <li>
        <h2><a href={postPath(post)} data-question-essay={post.id}>{post.data.title}</a></h2>
        <p>{note ?? post.data.description}</p>
        <span>{post.data.minutes} min read</span>
      </li>)}
    </ol>
  </div>
</Base>

<style>
  .question-detail__intro { max-inline-size: 65ch; font: 1.1rem/1.65 var(--font-body); }
  .question-detail__essays { padding: 0; list-style: none; max-inline-size: 46rem; margin-block-start: 1.4rem; }
  .question-detail__essays li { padding: 1.2rem 0; border-block-start: 1px solid var(--line); }
  .question-detail__essays h2 { margin: 0; font-size: clamp(1.6rem, 4vw, 2.2rem); }
  .question-detail__essays p { margin: .4rem 0; }
  .question-detail__essays span { color: var(--muted); font: .875rem var(--font-ui); }
</style>
