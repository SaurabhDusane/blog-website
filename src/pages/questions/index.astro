---
import Base from '../../layouts/Base.astro';
import EssayRow from '../../components/EssayRow.astro';
import FollowQuestion from '../../components/FollowQuestion.astro';
import { getJournalAuthor, getPosts, postPath, postRedirects } from '../../lib/content';
import { questionEntries, questionPath } from '../../lib/questions';
import '../../styles/discovery.css';

const [author, posts] = await Promise.all([getJournalAuthor(), getPosts()]);
const questions = (await questionEntries(posts)).filter(({ discoverable }) => discoverable);
const byId = new Map(posts.map((post) => [post.id, post]));
const aliases = postRedirects(posts);
const seen = new Set<string>();
const startingPoints = author.data.deskQuestions.flatMap(({ post, label, question }) => {
  const essay = byId.get(post) ?? aliases.get(post);
  if (!essay || seen.has(essay.id)) return [];
  seen.add(essay.id);
  return [{ essay, label, question }];
});
const empty = startingPoints.length === 0 && questions.length === 0;
---

<Base title="Questions" description="Start with a question and read the essays behind it." noindex={empty}>
  <div class="wrap discovery questions-page">
    <header class="discovery__header">
      <h1>Questions</h1>
      <p>What I’m thinking through in my essays.</p>
    </header>

    {startingPoints.length > 0 && <section aria-labelledby="starting-questions">
      <h2 id="starting-questions" class="sr-only">Questions to start with</h2>
      <ul class="essay-index" role="list">
        {startingPoints.map(({ essay, label, question }) => (
          <EssayRow href={postPath(essay)} title={question} description={essay.data.description} minutes={essay.data.minutes} topic={label} />
        ))}
      </ul>
    </section>}

    {questions.length > 0 && <section class="question-threads" aria-labelledby="follow-questions">
      <h2 id="follow-questions">Questions to follow</h2>
      <ul class="question-index" role="list">
        {questions.map(({ question, entries }) => <li data-question-entry>
          <h3><a href={questionPath(question)}>{question.data.title}</a></h3>
          <p>{question.data.description}</p>
          <FollowQuestion id={question.id} essays={entries.map(({ post }) => post.id)} />
        </li>)}
      </ul>
    </section>}

    {empty && <p class="archive__empty">I’m still working out what to ask next. <a href="/explore/">Browse my essays</a>.</p>}
  </div>
</Base>

<style>
  .questions-page { max-inline-size: 62rem; padding-block: clamp(2rem, 5vw, 4rem) 0; }
  .questions-page .discovery__header { padding-block-end: clamp(1rem, 3vw, 2rem); }
  .question-threads { margin-block-start: clamp(1.5rem, 5vw, 3.25rem); max-inline-size: 48rem; }
  .question-threads > h2 { font-size: clamp(2rem, 5vw, 3.15rem); }
  .question-index { display: grid; margin: .65rem 0 0; padding: 0; list-style: none; }
  .question-index li { padding: 1rem 0; border-block-end: 1px solid var(--line); }
  .question-index li[data-following] { order: -1; }
  .question-index h3 { margin: 0; font-size: clamp(1.8rem, 5vw, 2.7rem); overflow-wrap: anywhere; }
  .question-index p { margin: .4rem 0; color: var(--muted); }
</style>
