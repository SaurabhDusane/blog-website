---
import Base from '../layouts/Base.astro';
import ArchiveQuestions from '../components/ArchiveQuestions.astro';
import EssayRow from '../components/EssayRow.astro';
import RelatedReading from '../components/RelatedReading.astro';
import { getPosts, getTopics, postPath } from '../lib/content';
import { feelings } from '../lib/feelings';
import '../styles/discovery.css';

const [posts, topics] = await Promise.all([getPosts(), getTopics()]);
const topicNames = new Map(topics.map((topic) => [topic.id, topic.data.name]));
const moods = [...new Set(posts.map(({ data }) => data.mood))].sort();
const noteCount = posts.filter(({ data }) => data.looseThread).length;
const noun = noteCount === 0 ? 'essay' : noteCount === posts.length ? 'note' : 'piece';
---

<Base title="Essays" description="Browse and search Saurabh Dusane’s writing on Second Ink.">
  <div class="wrap discovery writing" data-explore>
    <header class="discovery__header">
      <h1>Essays</h1>
    </header>

    <div class="archive">
        <form class="archive__filters" action="/explore/" method="get" role="search" aria-label="Search my writing" hidden>
          <label class="archive__search">
            <span>Search my writing</span>
            <input type="search" name="q" maxlength="120" placeholder="Search titles and text" />
          </label>
          <div class="archive__tools">
            <label class="archive__format" data-format-filter hidden>
              <span>Format</span>
              <select name="kind">
                <option value="">All writing</option>
                <option value="essays">Essays</option>
                <option value="notes">Short notes</option>
              </select>
            </label>
            <details class="archive__options" data-archive-filters>
              <summary>Filters</summary>
              <div class="archive__selects">
                <label data-topic-filter hidden>
                  <span>Topic</span>
                  <select name="topic">
                    <option value="">Every topic</option>
                    {topics.map((topic) => <option value={topic.id}>{topic.data.name}</option>)}
                  </select>
                </label>
                <label>
                  <span>Reading time</span>
                  <select name="time">
                    <option value="">Any length</option>
                    <option value="quick">5 minutes or less</option>
                    <option value="steady">6–10 minutes</option>
                    <option value="long">11 minutes or more</option>
                  </select>
                </label>
                <label>
                  <span>Mood</span>
                  <select name="mood">
                    <option value="">Any mood</option>
                    {moods.map((mood) => <option value={mood}>{mood[0].toUpperCase() + mood.slice(1)}</option>)}
                  </select>
                </label>
                <label>
                  <span>Reader feeling</span>
                  <select name="feeling">
                    <option value="">Any feeling</option>
                    {feelings.map(({ id, label }) => <option value={id}>{label}</option>)}
                  </select>
                </label>
              </div>
            </details>
            <button class="archive__reset" type="button" data-reset-filters hidden>Clear search and filters</button>
          </div>
        </form>

      <section class="archive__results" aria-labelledby="archive-title">
        <header class="index-heading">
          <h2 id="archive-title" class="sr-only">Published writing</h2>
          <p data-result-count role="status">{posts.length} {noun}{posts.length === 1 ? '' : 's'}</p>
        </header>
        <ul class="essay-index" role="list" data-essay-index>
          <template id="desk-essay-row">
            <EssayRow
              href="/posts/DESK-ROW-SLUG/"
              title="DESK-ROW-TITLE"
              description="DESK-ROW-DESCRIPTION"
              minutes={0}
              mood="DESK-ROW-MOOD"
              filter={{ text: 'DESK-ROW-DESCRIPTION DESK-ROW-LABELS DESK-ROW-MOOD', topics: 'DESK-ROW-TOPICS' }}
            />
          </template>
          {posts.map((post) => {
            const { data } = post;
            const names = data.topics.map(({ id }) => topicNames.get(id) ?? id);
            return (
              <EssayRow
                href={postPath(post)}
                title={data.title}
                description={data.description}
                minutes={data.minutes}
                mood={data.mood}
                topic={data.looseThread ? 'Short note' : names[0]}
                filter={{ text: `${data.description} ${names.join(' ')} ${data.mood}`, topics: data.topics.map(({ id }) => id).join(' '), kind: data.looseThread ? 'note' : undefined }}
              />
            );
          })}
        </ul>
        <p class="archive__empty" data-no-results hidden>Nothing in this stack. Try a wider search.</p>
        <p class="archive__search-notice" data-search-notice hidden>The full text couldn’t load. You can still search titles, summaries, and topics.</p>
        <p class="archive__search-notice" data-feeling-notice hidden>I couldn’t see the reader feelings. The other filters still work.</p>
      </section>
      <div class="archive__extras">
        <RelatedReading posts={posts} />
        <ArchiveQuestions />
      </div>
    </div>
  </div>
</Base>

<style>
  .writing { max-inline-size: 62rem; padding-block: clamp(2rem, 5vw, 4rem) 0; }
  .writing .discovery__header { padding-block-end: clamp(1rem, 2.8vw, 1.75rem); }

  .archive__search-notice, .archive :global(.archive__excerpt) {
    color: var(--muted);
    font-size: .9rem;
    line-height: 1.55;
  }

  .archive :global(.archive__excerpt) {
    border-inline-start: 2px solid var(--blue);
    margin: .75rem 0 0;
    max-inline-size: 52ch;
    overflow-wrap: anywhere;
    padding-inline-start: .7rem;
  }

  .archive :global(.archive__excerpt mark) {
    background: var(--wash);
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--blue);
    text-underline-offset: .15em;
  }
</style>

<script>
  import '../scripts/explore';
</script>
