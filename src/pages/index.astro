---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import MoodWeather from '../components/MoodWeather.astro';
import draft from '../assets/draft.webp';
import { getPosts, postPath } from '../lib/content';

const posts = await getPosts();
const shortReads = posts.filter(({ data }) => data.minutes <= 5).slice(0, 3);
const postTitles = Object.fromEntries(posts.map(({ id, data }) => [id, data.title]));
const moods = [
  { id: 'reflective', label: 'Sit with it' },
  { id: 'practical', label: 'Try something' },
  { id: 'curious', label: 'Follow a thread' },
] as const;
const notes = moods.flatMap((mood) => {
  const post = posts.find(({ data }) => data.mood === mood.id);
  return post ? [{ ...mood, post }] : [];
});
const active = notes.find(({ post }) => post.id === posts[0]?.id)?.id ?? notes[0]?.id;
const dateLabel = new Intl.DateTimeFormat('en', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

<Base>
  <div class="wrap front">
    <header class="desk-intro">
      <h1>My reading desk</h1>
      <p class="desk-intro__day">I write here about what I read, what I make, and the ideas I can’t quite shake.</p>
      <p class="desk-intro__night">The desk lamp’s on. I’ve left a few notes here in case you’re still up.</p>
    </header>

    {notes.length > 0 ? <section class="desk-contours" aria-labelledby="desk-title" data-reading-desk>
      <h2 class="sr-only" id="desk-title">On the desk</h2>
      <div class="desk-stage">
        <div class="desk-chooser">
          <p id="desk-label">What are you in the mood for?</p>
          <div class="desk-tabs" role="tablist" aria-labelledby="desk-label" data-desk-tabs hidden>
            {notes.map(({ id, label }) => (
              <button id={`desk-tab-${id}`} role="tab" type="button" aria-selected={id === active ? 'true' : 'false'} aria-controls={`desk-panel-${id}`} tabindex={id === active ? 0 : -1}>
                {label}<span aria-hidden="true">↘</span>
              </button>
            ))}
          </div>
        </div>
        <div class="desk-notes">
          {notes.map(({ id, post, label }) => (
            <section id={`desk-panel-${id}`} class:list={['desk-sheet', id !== active && 'desk-sheet--unselected']} data-desk-panel aria-labelledby={`desk-note-${id}`}>
              <p class="desk-sheet__label eyebrow">{label}</p>
              <time datetime={post.data.publishedAt.toISOString()}>{dateLabel.format(post.data.publishedAt)}</time>
              <h3 id={`desk-note-${id}`}><a href={postPath(post)}>{post.data.title}</a></h3>
              <p class="desk-sheet__excerpt">{post.data.description}</p>
              <div class="desk-sheet__actions">
                <a class="text-link" href={postPath(post)}>Read this note <span aria-hidden="true">↗</span></a>
                <span>{post.data.minutes} min read</span>
              </div>
            </section>
          ))}
        </div>
        <figure class="desk-photo">
          <Image src={draft} alt="A folded draft and pencil with blue marks in the margin." widths={[320, 520, 800]} sizes="(min-width: 64rem) 32vw, 90vw" layout="constrained" loading="eager" fetchpriority="high" />
        </figure>
      </div>
    </section> : <p>The desk is empty. I’ll leave something here soon.</p>}

    <noscript>
      <style is:inline>
        .desk-sheet--unselected, .desk-sheet__label { display: block !important; }
        .desk-chooser { display: none !important; }
      </style>
    </noscript>

    <nav class="desk-links" aria-label="Essay archive">
      <a class="text-link" href="/explore/">Browse all essays</a>
    </nav>
    <MoodWeather postTitles={postTitles} />
    {shortReads.length > 0 && shortReads.length < posts.length && <section class="short-reads" aria-labelledby="short-reads-title">
      <h2 id="short-reads-title">Have five minutes?</h2>
      <ul>
        {shortReads.map((post) => <li><a href={postPath(post)}>{post.data.title}</a> <span>{post.data.minutes} min</span></li>)}
      </ul>
    </section>}
    <NewsletterForm id="home-newsletter" />
  </div>
</Base>

<script>
  const desk = document.querySelector('[data-reading-desk]');
  const tablist = desk?.querySelector<HTMLElement>('[data-desk-tabs]');
  if (tablist) {
    const verticalLayout = window.matchMedia('(min-width: 64rem)');
    const syncOrientation = () => tablist.setAttribute('aria-orientation', verticalLayout.matches ? 'vertical' : 'horizontal');
    const tabs = [...tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...(desk?.querySelectorAll<HTMLElement>('[data-desk-panel]') ?? [])];

    function openNote(index: number, focusTab = false) {
      for (const [position, tab] of tabs.entries()) {
        const selected = position === index;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
        const panel = panels[position];
        if (!panel) continue;
        panel.hidden = !selected;
        panel.classList.remove('desk-sheet--unselected');
        panel.setAttribute('role', 'tabpanel');
        panel.setAttribute('aria-labelledby', tab.id);
        panel.tabIndex = 0;
      }
      if (focusTab) tabs[index]?.focus();
    }

    for (const [index, tab] of tabs.entries()) {
      tab.addEventListener('click', () => openNote(index));
      tab.addEventListener('keydown', (event) => {
        let next: number;
        switch (event.key) {
          case 'ArrowRight':
          case 'ArrowDown': next = (index + 1) % tabs.length; break;
          case 'ArrowLeft':
          case 'ArrowUp': next = (index + tabs.length - 1) % tabs.length; break;
          case 'Home': next = 0; break;
          case 'End': next = tabs.length - 1; break;
          default: return;
        }
        event.preventDefault();
        openNote(next, true);
      });
    }

    openNote(Math.max(0, tabs.findIndex((tab) => tab.getAttribute('aria-selected') === 'true')));
    syncOrientation();
    verticalLayout.addEventListener('change', syncOrientation);
    tablist.hidden = false;
  }
</script>

<style>
  .front { padding-top: clamp(2.15rem, 6.5vw, 5.6rem); }
  .desk-intro { margin-block-end: clamp(1.6rem, 4.2vw, 3.35rem); }
  .desk-intro h1 { font-size: clamp(3.85rem, 9vw, 8rem); letter-spacing: -0.048em; line-height: .9; }
  .desk-intro p { max-width: 45ch; margin: 1rem 0 0; font: 400 clamp(1.15rem, 2vw, 1.42rem)/1.4 var(--font-body); color: var(--muted); }
  .desk-intro__night { display: none; }
  :global(html[data-clock='night']) .desk-intro__night { display: block; }
  :global(html[data-clock='night']) .desk-intro__day { display: none; }
  .desk-stage { display: grid; gap: 1px; border: 1px solid var(--ink); background: var(--ink); }
  .desk-chooser, .desk-notes, .desk-photo { min-width: 0; margin: 0; background: var(--paper); }
  .desk-chooser { padding: clamp(.85rem, 2.5vw, 1.7rem); }
  .desk-chooser p { margin: 0 0 .6rem; color: var(--muted); font: 500 .87rem/1.4 var(--font-ui); }
  .desk-tabs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .desk-tabs button {
    display: flex; align-items: center; justify-content: space-between; gap: .45rem;
    min-height: 2.75rem; padding: .55rem .5rem; background: transparent; color: var(--ink);
    border: 1px solid var(--line); border-right: 0; text-align: left;
    font: 550 clamp(.85rem, 1.25vw, 1.05rem)/1.22 var(--font-ui);
  }
  .desk-tabs button:last-child { border-right: 1px solid var(--line); }
  .desk-tabs button span { flex-shrink: 0; color: var(--blue); }
  .desk-tabs button[aria-selected='true'] { background: var(--blue); color: var(--button-ink); border-color: var(--blue); }
  .desk-tabs button[aria-selected='true'] span { color: inherit; }
  .desk-tabs button:not([aria-selected='true']):hover { background: var(--wash); }
  .desk-sheet { background: color-mix(in srgb, var(--paper) 74%, var(--wash)); min-height: 100%; padding: clamp(1.15rem, 3.5vw, 3rem); }
  .desk-sheet--unselected, .desk-sheet__label { display: none; }
  .desk-sheet + .desk-sheet { border-block-start: 1px solid var(--line); }
  .desk-sheet time, .desk-sheet__actions > span { font: 500 .87rem/1.3 var(--font-ui); color: var(--muted); }
  .desk-sheet h3 { max-width: 19ch; margin: .75rem 0; font-size: clamp(2.65rem, 5.1vw, 4.9rem); letter-spacing: -.025em; }
  .desk-sheet h3 a { color: var(--ink); text-decoration: none; text-decoration-thickness: 1px; }
  .desk-sheet h3 a:hover { color: var(--blue); text-decoration: underline; }
  .desk-sheet__excerpt { max-width: 42ch; margin: .8rem 0 .4rem; font: 400 clamp(1.05rem, 1.5vw, 1.28rem)/1.5 var(--font-body); }
  .desk-sheet__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0 1rem; margin-top: .5rem; }
  .desk-photo { min-height: 11rem; }
  .desk-photo img { width: 100%; height: 100%; aspect-ratio: 2.25; object-fit: cover; }
  .desk-links { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .25rem 1rem; margin: 1.05rem 0 clamp(1.65rem, 3vw, 2.6rem); }
  .short-reads {
    display: grid; gap: .95rem 2.5rem; margin-block-end: clamp(2.5rem, 6vw, 4.5rem);
    border-block-start: 1px solid var(--ink); padding-block-start: 1.5rem;
  }
  .short-reads h2 { font-size: clamp(2.1rem, 4.3vw, 3.15rem); }
  .short-reads ul { list-style: none; border-block-start: 1px solid var(--line); margin: 0; padding: 0; }
  .short-reads li { display: flex; align-items: center; justify-content: space-between; gap: .4rem 1rem; border-block-end: 1px solid var(--line); }
  .short-reads li a { display: inline-flex; align-items: center; min-height: 2.75rem; color: var(--ink); font: 400 clamp(1.22rem, 2.7vw, 1.65rem)/1.14 var(--font-display); }
  .short-reads li span { flex: none; font-size: .8rem; color: var(--muted); }
  @media (min-width: 53rem) { .short-reads { grid-template-columns: repeat(2, minmax(0,1fr)); } }
  @media (max-width: 26rem) {
    .desk-tabs button span { display: none; }
  }
  @media (min-width: 64rem) {
    .desk-stage { grid-template-columns: minmax(9.5rem, .52fr) minmax(18rem, 1.45fr) minmax(13.5rem, 1.03fr); }
    .desk-tabs { grid-template-columns: 1fr; }
    .desk-tabs button { border-width: 1px; min-height: 3.15rem; padding-inline: .75rem; }
    .desk-tabs button + button { border-top: 0; }
    .desk-photo img { aspect-ratio: 1.2; }
  }
</style>
