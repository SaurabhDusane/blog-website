---
import Base from '../layouts/Base.astro';
import ReaderHandoff from '../components/ReaderHandoff.astro';
import ReaderVoiceNote from '../components/ReaderVoiceNote.astro';
import RevisitEssay from '../components/RevisitEssay.astro';
import { getJournalAuthor } from '../lib/content';
import { journalAuthorPath } from '../lib/journal-author.mjs';
import '../styles/reader.css';

const author = await getJournalAuthor();
---

<Base title="DESK-TITLE" description="DESK-DESCRIPTION" type="article" wide>
  <div class="reader desk-essay" data-desk-essay="DESK-SLUG">
    <div class="reader-progress" role="progressbar" aria-label="Reading progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" hidden>
      <div class="reader-progress__fill"></div>
    </div>
    <header class="reader-header wrap">
      <a class="reader-back" href="/explore/">All essays</a>
      <Fragment set:html={'DESK-TOPICS'} />
      <h1 id="reader-title">DESK-TITLE</h1>
      <p class="reader-deck">DESK-DESCRIPTION</p>
      <div class="reader-meta">
        <span>By <a href={journalAuthorPath}>{author.data.name}</a></span>
        <time datetime="DESK-PUBLISHED">DESK-DATE</time><span>DESK-MINUTES min read</span><span class="reader-mood">DESK-MOOD</span>
      </div>
      <ReaderVoiceNote postId="DESK-SLUG" />
      <RevisitEssay postId="DESK-SLUG" title="DESK-TITLE" minutes="DESK-MINUTES" />
    </header>
    <div class="reader-sticky-scope">
      <div class="reader-controls-outer" data-desk-handoff-bar hidden>
        <div class="reader-controls wrap">
          <button type="button" class="reader-control text-link" data-reader-handoff-open aria-haspopup="dialog" hidden>Continue on another device</button>
        </div>
      </div>
      <article class="reader-article wrap" aria-labelledby="reader-title">
        <Fragment set:html={'DESK-DOCUMENT'} />
        <div class="reader-prose" data-desk-prose><Fragment set:html={'DESK-PROSE'} /></div>
      </article>
    </div>
    <ReaderHandoff />
  </div>
</Base>

<script>
  import { readLibrary, recordReading } from '../lib/reader-state';
  import { initReaderHandoff } from '../scripts/reader-handoff';
  import { trackReadership } from '../scripts/reader-readership';

  const essay = document.querySelector<HTMLElement>('[data-desk-essay]');
  const postId = essay?.dataset.deskEssay;
  if (postId) trackReadership(postId);
  const progress = essay?.querySelector<HTMLElement>('.reader-progress');
  const fill = progress?.querySelector<HTMLElement>('.reader-progress__fill');
  const prose = essay?.querySelector<HTMLElement>('[data-desk-prose]');
  if (essay && postId && progress && fill && prose) {
    const passages = [...prose.querySelectorAll<HTMLElement>(':scope > [id]')];
    const bar = essay.querySelector<HTMLElement>('[data-desk-handoff-bar]');
    const title = essay.querySelector('h1')?.textContent;
    if (passages.length && bar && title) {
      const controller = new AbortController();
      initReaderHandoff(essay, title, () => {
        const readingLine = Math.min(window.innerHeight * .33, 250);
        const passage = passages.findLast((entry) => entry.getBoundingClientRect().top <= readingLine) ?? passages[0];
        const url = new URL(location.pathname, location.origin);
        url.hash = passage.id;
        return url.href;
      }, controller.signal);
      bar.hidden = !!bar.querySelector('[data-reader-handoff-open][hidden]');
      document.addEventListener('astro:before-swap', () => controller.abort(), { once: true });
    }
    const prior = readLibrary().history[postId];
    let lastSaved = prior?.progress ?? 0;
    let pending = lastSaved;
    let timer = 0;

    const measure = () => {
      const { top, height } = prose.getBoundingClientRect();
      const end = window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;
      const fraction = end && top + height <= window.innerHeight ? 1 : (.67 * window.innerHeight - top) / Math.max(1, height);
      const percent = Math.round(Math.min(1, Math.max(0, fraction)) * 100);
      progress.setAttribute('aria-valuenow', String(percent));
      fill.style.transform = `scaleX(${percent / 100})`;
      return percent;
    };
    const save = () => {
      window.clearTimeout(timer);
      if (!pending || pending === lastSaved) return;
      recordReading(postId, pending);
      lastSaved = pending;
    };
    window.addEventListener('scroll', () => {
      pending = measure();
      window.clearTimeout(timer);
      timer = window.setTimeout(save, 600);
    }, { passive: true });
    window.addEventListener('pagehide', save);
    new ResizeObserver(measure).observe(prose);
    progress.hidden = false;
    measure();

    if (!location.hash && new URLSearchParams(location.search).get('resume') === '1' && prior && prior.progress > 0 && prior.progress < 100 && !prior.completed) {
      window.requestAnimationFrame(() => {
        const { top, height } = prose.getBoundingClientRect();
        window.scrollTo({ top: window.scrollY + top + height * prior.progress / 100 - window.innerHeight * .67 });
      });
    }
  }
</script>

<style>
  .desk-essay {
    --reader-anchor-space: calc(var(--reader-sticky-top) + 3.75rem);
    padding-block-end: clamp(3rem, 8vw, 6rem);
  }
  .desk-essay .reader-header { margin-block-end: clamp(1rem, 4vw, 2.5rem); }
  .desk-essay :global(.desk-essay__original) { margin: 0 auto 1.5rem; max-inline-size: 68ch; }
  .desk-essay .reader-prose :global([id]) { scroll-margin-block-start: var(--reader-anchor-space); }
</style>
