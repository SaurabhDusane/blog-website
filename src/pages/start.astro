---
import Base from '../layouts/Base.astro';
import EssayRow from '../components/EssayRow.astro';
import ReadingPathProgress from '../components/ReadingPathProgress.astro';
import { getPosts, getSeries, postPath, readingPathPosts } from '../lib/content';
import { journalAuthorPath } from '../lib/journal-author.mjs';
import '../styles/discovery.css';

const [series, posts] = await Promise.all([getSeries(), getPosts()]);
const paths = series.map((path) => ({
  path,
  stops: readingPathPosts(path, posts),
})).filter(({ stops }) => stops.length > 0);
const hasPaths = paths.length > 0;
---

<Base title="Start here" description="Find a place to start reading Second Ink." noindex={!hasPaths}>
  <div class="wrap discovery start-page">
    <header class="discovery__header">
      <h1>Start here</h1>
      {hasPaths && <p>Pick the idea that’s on your mind. Each path links a few essays you can read in one sitting or come back to.</p>}
    </header>

    {!hasPaths && <div class="start-page__links">
      {posts.length > 0 && <a class="button" href={`${journalAuthorPath}#question-desk-heading`}>Pick a question at my desk</a>}
      <a class={posts.length > 0 ? 'text-link' : 'button'} href="/explore/">Browse all essays</a>
    </div>}
    {hasPaths && <div class="start-page__paths">
      {paths.map(({ path, stops }) => (
        <section class="reading-path" aria-labelledby={`path-${path.id}`}>
          <div class="reading-path__intro">
            <h2 id={`path-${path.id}`}>{path.data.title}</h2>
            <p>{path.data.description}</p>
            <a class="text-link" href={`/series/${path.id}/`} aria-label={`Open reading path: ${path.data.title}`}>Open reading path <span aria-hidden="true">→</span></a>
            <ReadingPathProgress posts={stops} />
          </div>
          <ol class="essay-index reading-path__stops" role="list">
            {stops.map((post) => <EssayRow href={postPath(post)} title={post.data.title} description={post.data.description} minutes={post.data.minutes} compact />)}
          </ol>
        </section>
      ))}
    </div>}
  </div>
</Base>

<style>
  .start-page__links {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: .5rem 1rem;
    margin-block-start: 1.5rem;
  }
</style>
