---
import type { InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import CopyTextDialog from '../../../components/CopyTextDialog.astro';
import EssayRow from '../../../components/EssayRow.astro';
import { getJournalAuthor, postPath } from '../../../lib/content';
import { journalAuthorPath } from '../../../lib/journal-author.mjs';
import { editionDate, editionEntries, editionPath } from '../../../lib/editions';

export async function getStaticPaths() {
  const [entries, author] = await Promise.all([editionEntries(), getJournalAuthor()]);
  return entries.map((entry) => ({
    params: { slug: entry.edition.id },
    props: { ...entry, author },
  }));
}

const { edition, essays, discoverable, author } = Astro.props as InferGetStaticPropsType<typeof getStaticPaths>;
const { Content } = await render(edition);
const { title, description, publishedAt } = edition.data;
const address = new URL(editionPath(edition), Astro.site ?? Astro.url);
const minutes = essays.reduce((sum, { entry }) => sum + entry.data.minutes, 0);
---

<Base title={title} description={description} type="article" noindex={essays.length === 0}>
  <article class="wrap interior edition">
    <header class="edition-header">
      <a class="text-link" href={discoverable ? '/editions/' : '/explore/'}>{discoverable ? 'All editions' : 'Browse my essays'}</a>
      <h1>{title}</h1>
      <p class="lead">{description}</p>
      <div class="edition-meta">
        <time datetime={publishedAt.toISOString()}>{editionDate.format(publishedAt)}</time>
        <span>Selected by <a href={journalAuthorPath}>{author.data.name}</a></span>
        {essays.length > 0 && <span>{essays.length} {essays.length === 1 ? 'essay' : 'essays'} · {minutes} min</span>}
      </div>
    </header>

    {edition.body?.trim() && <div class="edition-intro"><Content /></div>}

    <section class="edition-order" aria-labelledby="edition-order-title">
      <h2 id="edition-order-title">Read in this order</h2>
      {essays.length > 0 ? (
        <ol class="editorial-list" role="list">
          {essays.map(({ entry, note }) => (
            <EssayRow href={postPath(entry)} title={entry.data.title} description={note ?? entry.data.description} minutes={entry.data.minutes} />
          ))}
        </ol>
      ) : <p>The essays for this edition are being gathered.</p>}
    </section>

    <div class="edition-actions" data-edition-actions data-edition-url={address.href}>
      <button class="text-link" type="button" data-copy-edition hidden>Copy edition link</button>
      <a class="text-link" href={editionPath(edition) + 'newsletter.txt'} download={edition.id + '-newsletter.md'}>Download newsletter draft</a>
      <p role="status" aria-atomic="true" data-edition-status></p>
      <CopyTextDialog id="edition-copy" />
    </div>
  </article>
</Base>

<script>
  import { copyText } from '../../../lib/clipboard';

  const actions = document.querySelector<HTMLElement>('[data-edition-actions]');
  const button = actions?.querySelector<HTMLButtonElement>('[data-copy-edition]');
  const status = actions?.querySelector<HTMLElement>('[data-edition-status]');
  const fallback = actions?.querySelector<HTMLDialogElement>('[data-copy-dialog]') ?? null;
  const url = actions?.dataset.editionUrl;
  if (button && status && url) {
    button.hidden = false;
    button.addEventListener('click', async () => {
      const copied = await copyText(url, fallback);
      status.textContent = copied ? 'Edition link copied.' : '';
    });
  }
</script>

<style>
  .edition { max-inline-size: 59rem; }
  .edition-header h1 { margin-block: .85rem .6rem; max-inline-size: 18ch; text-wrap: balance; overflow-wrap: anywhere; }
  .edition-header .lead { margin-block-end: .85rem; }
  .edition-meta { display: flex; flex-wrap: wrap; gap: .3rem .9rem; color: var(--muted); font-size: .9rem; }
  .edition-intro { max-inline-size: 60ch; margin-block: 1.6rem; font: 400 1.12rem/1.65 var(--font-body); }
  .edition-order { margin-block-start: clamp(2rem, 6vw, 3.65rem); }
  .edition-order h2 { margin-block-end: .85rem; font-size: clamp(2rem, 4.35vw, 3rem); }
  .edition-actions { display: flex; flex-wrap: wrap; align-items: center; column-gap: 1rem; margin-block-start: 1rem; }
  .edition-actions button { background: transparent; border: 0; padding: 0; text-decoration: underline; text-underline-offset: .18em; }
  .edition-actions button[hidden] { display: none; }
  .edition-actions p { margin: 0; color: var(--muted); font-size: .88rem; }
</style>
