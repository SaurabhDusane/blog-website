---
import Base from '../layouts/Base.astro';
---
<Base title="Page missing" description="Find your way back to the Second Ink essay index." noindex>
  <section class="wrap interior missing-page">
    <p class="eyebrow">404</p>
    <h1>That page slipped out of the stack.</h1>
    <div class="missing-links">
      <a class="button" href="/explore/">Explore the essays <span aria-hidden="true">↗</span></a>
      <a class="text-link" href="/">Back to the front page</a>
    </div>
  </section>
</Base>
<style>
  .missing-page h1 { max-width: 14ch; }
  .missing-links { display: flex; flex-wrap: wrap; gap: 0.75rem 1.25rem; margin-block-start: 2rem; }
</style>
