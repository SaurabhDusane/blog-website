---
import { getCollection, render } from 'astro:content';
import '../../styles.css';
export async function getStaticPaths() { return (await getCollection('posts')).map((post) => ({ params: { slug: post.id }, props: { post } })); }
const { post } = Astro.props;
const { Content } = await render(post);
const { title, minutes, publishedAt, updatedAt, documentSource } = post.data;
---
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{title} · Second Ink publishing test</title></head>
<body><main><a href="/">All sample notes</a><article><h1>{title}</h1>
<p class="label"><time datetime={publishedAt.toISOString()}>{publishedAt.toISOString().slice(0, 10)}</time> · {minutes} min</p>
{updatedAt && <p>Updated <time datetime={updatedAt.toISOString()}>{updatedAt.toISOString().slice(0, 10)}</time></p>}
{documentSource.originalUrl && <p><a href={documentSource.originalUrl}>Read the original PDF</a></p>}
<Content /></article></main></body></html>
